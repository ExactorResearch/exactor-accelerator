# =============================================================================
# Exactor Accelerator — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API tokens.
#
# Alternatively, set these as OS environment variables or use:
#   import exactor_accelerator
#   exactor_accelerator.configure(exactor_core_token="your-token")
# =============================================================================

# EXACTOR Core Engine (https://exactor.tech)
# Required for cloud-accelerated boolean minimization.
# Get your token at https://exactor.tech/dashboard
EXACTOR_CORE_TOKEN=
EXACTOR_BASE_URL=https://exactor.tech

# TypeSafe AI Jev API
# Required for probabilistic calibration and RLCD decisions.
JEV_API_KEY=
# TYPESAFE_API_KEY=  # Legacy alias, use JEV_API_KEY instead

# DeepSeek LLM Explainer (optional)
# Enables natural-language explanations for audit/compliance.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
